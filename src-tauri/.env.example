# Copy this file to src-tauri/.env and fill in your API credentials.
# They are embedded into the binary at compile time (build.rs), so datasheet
# search works in portable builds without shipping this file.
#
# DigiKey: https://developer.digikey.com/
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Farnell / element14: https://partner.element14.com/
ELEMENT14_API_KEY=

# TME: https://developers.tme.eu/
TME_TOKEN=
TME_SECRET=
